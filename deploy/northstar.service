[Unit]
Description=Northstar repair desk
After=network.target
[Service]
User=northstar
Group=northstar
EnvironmentFile=/etc/northstar.env
ExecStart=/usr/bin/python3 /opt/northstar/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/northstar
UMask=0077
[Install]
WantedBy=multi-user.target
